{
  "name": "citygenerator",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Procedural generator and editor for metropolitan-scale tabletop maps",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @citygen/web dev",
    "build": "pnpm -r --filter './packages/*' build && pnpm --filter @citygen/web build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm --filter @citygen/web e2e",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "sweep": "node packages/engine/scripts/sweep.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
