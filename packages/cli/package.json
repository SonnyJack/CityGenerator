{
  "name": "@citygen/cli",
  "version": "0.0.0",
  "private": true,
  "description": "citygen command line: generate, export and serve regions headlessly; MCP server over the assistant tools",
  "license": "MIT",
  "type": "module",
  "bin": {
    "citygen": "./bin/citygen.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@citygen/assistant": "workspace:*",
    "@citygen/core": "workspace:*",
    "@citygen/editor": "workspace:*",
    "@citygen/engine": "workspace:*",
    "@citygen/export": "workspace:*",
    "@citygen/import": "workspace:*",
    "@citygen/themes": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "vitest": "^5.0.1",
    "@citygen/tiles": "workspace:*"
  }
}
