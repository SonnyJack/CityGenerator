{
  "name": "@citygen/engine",
  "version": "0.0.0",
  "private": true,
  "description": "Headless engine: runs the pipeline for a document, serves tiles and answers queries (browser worker, CLI, MCP)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
