    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@citygen/core": "workspace:*",
    "@citygen/export": "workspace:*",
    "@citygen/features": "workspace:*",
    "@citygen/tiles": "workspace:*",
    "@types/geojson": "^7946.0.16"
  },
  "devDependencies": {
    "vitest": "^5.0.1"
  }
}
